APP_NAME="Blood Repository"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Explicit local development database. Production target: MySQL.
DB_CONNECTION=sqlite
# For MySQL, set DB_CONNECTION=mysql and uncomment/provide:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=blood_repository
# DB_USERNAME=blood_repository_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=blood_repository_session
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Production requires APP_ENV=production, APP_DEBUG=false,
# HTTPS, SESSION_SECURE_COOKIE=true, and approved MySQL credentials.

# Optional daily local SQLite snapshot time (HH:MM, Asia/Manila).
# Leave blank until the schedule and private storage are approved.
REPOSITORY_BACKUP_AT=
